#!/bin/sh
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/../.." && pwd)
. "$here/platform"
"$here/bootstrap" >&2
key=$("$here/image-key")
# Without ASLR: the image's TSan (clang 14) aborts on the mappings a kernel with vm.mmap_rnd_bits 32 (WSL2) gives.
MSYS_NO_PATHCONV=1 exec docker run --rm --init --platform "$platform" --network none --security-opt seccomp=unconfined \
    --env TSAN_OPTIONS=halt_on_error=1:allow_addr2line=1:external_symbolizer_path=/usr/bin/addr2line \
    --mount "type=bind,source=$(host_path "$root"),target=/work" \
    --mount "type=bind,source=$(host_path "$HOME/.cache/ugohttp/src"),target=/sources,readonly" \
    "$(cat "$root/out/container/$key.iid")" setarch -R python3 /work/tests/container/tsan.py
