#!/bin/sh
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/../.." && pwd)
. "$here/platform"
"$here/bootstrap" >&2
key=$("$here/image-key")
MSYS_NO_PATHCONV=1 exec docker run --rm --init --platform "$platform" --cap-add NET_ADMIN --network none \
    --tmpfs /fault-disk:rw,size=1m,mode=1777 \
    --mount "type=bind,source=$(host_path "$root"),target=/work" \
    "$(cat "$root/out/container/$key.iid")" "$@"
